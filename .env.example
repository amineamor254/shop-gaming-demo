# No environment variables are required or read by the template as shipped.
# The following names are examples only for future server-side integrations;
# the current code does not read them. Add only the variables your integration
# actually needs, and never commit real secret values.
#
# Payment provider secret (server only):
# PAYMENT_PROVIDER_SECRET=
# Authentication provider secret (server only):
# AUTH_SECRET=
# Database connection string (server only):
# DATABASE_URL=
# Contact form service endpoint:
# CONTACT_FORM_ENDPOINT=
# Newsletter provider API key (server only):
# NEWSLETTER_API_KEY=
# Order confirmation email provider API key (server only):
# EMAIL_PROVIDER_API_KEY=
